      "metadata": {
        "name": "ANNO ZERO, ARCHITECTURE FOR RETURN, GAZA'S STRIP.",
        "author": "GUGLIELMO VITELLI, FRANCESCO ZAROTTI",
        "year": "2026,Y4",
        "tags": [
          "architecture",
          "model",
          "urban"
        ],
        "description": "<br>AnnoZero addresses the housing emergency in the Gaza Strip through a network of temporary, self-built micro-villages designed for displaced communities.<br><br>Each village hosts around 265 people and functions as a self-sufficient micro-community, built with the modular U-Build system. Operating across territorial and architectural scales, the project transforms vacant land and former control devices into spaces for living, learning, and gathering. Rather than rebuilding the city, AnnoZero initiates a process of return, resilience, and renewal, leaving traces that become the groundwork for future regeneration.<br><br>Instagram Handles:<br>GUGLIELMO VITELLI @gughi.vite<br>FRANCESCO ZAROTTI @lifeofcesco<br>",
        "course": "Master'S Degree Thesis",
        "prof": "Massimiliano Roca"
      }
