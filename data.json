      "metadata": {
        "name": "AnnoZero",
        "author": "Guglielmo Vitelli & Francesco Zarotti",
        "year": "2026",
        "tags": [
          "architecture",
          "model"
        ],
        "description": "AnnoZero addresses the housing emergency in the Gaza Strip through a network of temporary, self-built micro-villages designed for displaced communities.<br>Each village hosts around 265 people and functions as a self-sufficient micro-community, built with the modular U-Build system. Operating across territorial and architectural scales, the project transforms vacant land and former control devices into spaces for living, learning, and gathering. Rather than rebuilding the city, AnnoZero initiates a process of return, resilience, and renewal, leaving traces that become the groundwork for future regeneration.<br>"
      }
