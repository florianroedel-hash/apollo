      "metadata": {
        "name": "DJILAK SECONDARY SCHOOL",
        "author": "Gabriele Morelli, Filippo Omini",
        "year": "2026",
        "tags": [
          "architecture"
        ],
        "description": "In the vast Senegalese savanna, architecture becomes a tool for social redemption. Utilizing a modular rhythm of regularly spaced rammed earth walls, interchangeable spaces dedicated to learning are created. These structural sets extend outward, transforming into outdoor libraries and integrated seating, to facilitate a school life lived primarily in the open air. Interlocking cylindrical terracotta pots work purely in compression, creating arches that cover large spans, which can be built with minimal scaffolding to limit costs. Above the vaults, a corrugated steel sheet is elevated by longitudinal purlins to trigger a dual-flow natural ventilation system, countering the intense Senegalese heat. The construction site functions as a “school within a school,” engaging local artisans to integrate local knowledge with new technical skills. By fostering economic emancipation for adults and providing a dignified learning environment for youth, the project ensures that architecture is the physical place where territory and aspirations finally coincide.<br><br>Instagram Handles:<br>Gabriele Morelli @gab__morelli<br>Filippo Omini @filippo.omini",
        "course": "Archstorming Senegal Secondary School",
        "track": "Spring 2026 — Y4, Laurea Magistrale"
      }
