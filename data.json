      "metadata": {
        "name": "INSIDE THE SALMON SKIN",
        "author": "Nicolò Mario Terruso; Sasha Fasolo Massoli",
        "year": "2026",
        "tags": [
          "architecture"
        ],
        "description": "The project focuses on the upcycling of decommissioned salmon fishing rings in Tromsø, Norway, to create floating, modular nesting structures for kittiwakes during the breeding season.<br><br>Jury statement:<br>“This proposal confronts us with a powerful idea, can we reuse the ubiquitous circular sea farming structure as a floating sanctuary for Kittiwakes? The jury believes this proposal sketches out a solution in an exemplary way, upcycling industrial waste at scale. The solution is cost efficient, believable and extremely flexible. The proposal also addresses the Kittiwakes need for a partially sheltered solution, and we can see the potential for developing this into an attraction for experience based tourism.”<br><br>Instagram Handles:<br>Nicolò Mario Terruso @nicolo.terruso<br>Sasha Fasolo Massoli @sashafasolomassoli<br>",
        "competition": "120 hours 2026",
        "result": "Winner 2026"
      }
